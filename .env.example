# step 1 : open https://www.tradingview.com/symbols/BTCUSD/ideas/ in broswer
# step 2 : open dev tools (F12) and go to network tab
# step 3 : verify the captha
# step 4 : refresh the page and find the get request on top of the list with url https://www.tradingview.com/symbols/BTCUSD/ideas/
# step 5 : copy the cookie and paste it here
# Note : Make sure to convert the string to Escape-string (https://onlinestringtools.com/escape-string)
TRADINGVIEW_COOKIE = "your_cookie_here"

# ─── Tickvale API ─────────────────────────────────────
# Comma separated keys, optionally named:  name:key,name2:key2   (generate with: openssl rand -hex 24)
# Leave empty for OPEN mode (local use only).
API_KEYS=
# Refuse to start serving data without keys even if API_KEYS is empty (set true in production).
REQUIRE_API_KEY=false
# Requests per minute per key (per IP in open mode).
RATE_LIMIT_PER_MINUTE=120
# Browser origins allowed to call /v1 directly, comma separated. Empty = same-origin only.
CORS_ORIGINS=
# Serve the bundled web UI. Set false for an API-only deployment.
ENABLE_WEB_UI=true
# REST response cache lifetime in seconds.
CACHE_TTL_SECONDS=60
# Live streaming limits.
WS_MAX_SYMBOLS_PER_CLIENT=100
WS_MAX_CLIENTS_PER_KEY=5
HUB_MAX_UPSTREAM_SYMBOLS=500
# Trust X-Forwarded-For for client IPs (only behind a proxy you control).
TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO
# Which country to prefer when a name matches listings in several (for example "TCS"). Two letters; empty = no preference.
DEFAULT_COUNTRY=IN
# Extra Python modules to load at startup, comma separated. Each one registers its own operations and
# live channels so they appear on the WebSocket next to the built-in ones. See docs/EXTENDING.md.
PLUGINS=
# Data sources, in the order they are asked. Default: tradingview. Brokers (added as plugins) go first, e.g.
#   PROVIDERS=nse,tradingview         -> NSE official source first for Indian stocks (check NSE terms)
#   PROVIDERS=zerodha,tradingview     -> broker first, TradingView only fills gaps
#   PROVIDERS=zerodha                 -> brokers only, TradingView switched off
PROVIDERS=tradingview
# Tickvale is read-only. This stays false; it only exists so order features can be added deliberately later.
ALLOW_TRADING=false
# One key per product, each with its own permissions and limits. Create entries with:
#   python -m api.keys nesto --operations quotes,candles --channels quotes --rate 300 --append clients.json
# See clients.example.json and docs/BRIDGE.md.
CLIENTS_FILE=
